<?xml version="1.0" ?>
<!DOCTYPE Xdmf SYSTEM "Xdmf.dtd" []>
<Xdmf Version="2.0">
 <Domain>
     <Grid Name="Mesh" GridType="Uniform">
         <Topology TopologyType="3DRectMesh" Dimensions="128 41 144"/>
         <Geometry GeometryType="VXVYVZ">
             <DataItem Dimensions="144" NumberType="Float" Precision="4" Format="HDF">
                T_box_step_0.00000.h5:/X
             </DataItem>
             <DataItem Dimensions="41" NumberType="Float" Precision="4" Format="HDF">
                T_box_step_0.00000.h5:/Y
             </DataItem>
             <DataItem Dimensions="128" NumberType="Float" Precision="4" Format="HDF">
                T_box_step_0.00000.h5:/Z
             </DataItem>
         </Geometry>
         <Attribute Name="Temperature" AttributeType="Scalar" Center="Node">
             <DataItem Dimensions="128 41 144" NumberType="Float" Precision="4" Format="HDF">
                T_box_step_0.00000.h5:/Temperature
             </DataItem>
         </Attribute>
     </Grid>
 </Domain>
</Xdmf>
